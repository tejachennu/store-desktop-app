# Central API configuration
PORT=4000
DATABASE_URL=postgres://store:store@localhost:5432/store
# Use a long random value in production: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=480
# Comma separated; Electron renderer uses file:// / app:// and does not need CORS
CORS_ORIGINS=
LOG_LEVEL=info
# Postgres pool size
DB_POOL_MAX=20
BUSINESS_TZ=Asia/Kolkata
