{
  "name": "@store/desktop",
  "productName": "Store Manager",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first warehouse & branch store management",
  "author": "StoreCo",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "npm run rebuild:electron && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "npm run rebuild:node --if-present >/dev/null 2>&1; vitest run",
    "rebuild:electron": "electron-builder install-app-deps",
    "rebuild:node": "cd ../.. && npm rebuild better-sqlite3",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@store/shared": "*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "pg": "^8.16.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "zod": "^4.1.0"
  }
}
